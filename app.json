{
  "expo": {
    "name": "AI Usage",
    "slug": "usage",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "usage",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.nextroad-dev.aiusage",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["en", "zh-Hans"]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow AI Usage to use Face ID to lock the app."
        }
      ],
      "expo-background-task",
      "@preeternal/react-native-cookie-manager",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.nextroad-dev.aiusage",
          "widgets": [
            {
              "name": "UsageWidget",
              "displayName": "AI Usage",
              "description": "Remaining quota of your AI subscriptions at a glance.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": ["ios", "android"],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.nextroad-dev.aiusage.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.nextroad-dev.aiusage"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "e0167088-bc54-48ff-8bd2-6890e558666b"
      }
    },
    "android": {
      "package": "com.nextroad.aiusage",
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#0B0B0C"
      }
    }
  }
}
